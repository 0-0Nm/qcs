{
  "name": "snowcat-framework",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json"
  },
  "exports": {
    ".": {
      "import": "./index.ts"
    },
    "./*": {
      "import": "./*"
    }
  },
  "dependencies": {
    "snowcat-core": "workspace:*",
    "snowcat-common": "workspace:*",
    "snowcat-database": "workspace:*",
    "snowcat-protobuf": "workspace:*",
    "snowcat-adapter": "workspace:*",
    "snowcat-webui-backend": "workspace:*",
    "snowcat-vite": "workspace:*",
    "snowcat-qrcode": "workspace:*",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}